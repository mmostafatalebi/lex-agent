# LexAgent environment configuration
# Copy this file to .env and fill in values.

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_RETRIES=3

# PostgreSQL + pgvector
DATABASE_URL=postgresql://lexagent:lexagent@localhost:5432/lexagent

# LangGraph checkpointer (SQLite path, relative to repo root)
LEXAGENT_CHECKPOINT_PATH=.data/checkpoints.db

# Eval cache mode: auto | replay | record | live
LEXAGENT_EVAL_MODE=auto

# Checkpointer backend: sqlite | postgres
CHECKPOINT_BACKEND=sqlite

# HTTP API
S3_BUCKET=
REQUIRE_API_KEY=false
LEXAGENT_API_KEY=
